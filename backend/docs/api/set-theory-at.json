{
    "readme": "Listed status codes cover business-logic-specific responses only; additional status codes may apply as defined in the statuses section.",
    "statuses": {
        "401": "Unauthorized",
        "403": "Forbidden",
        "404": "Not Found",
        "405": "Method Not Allowed",
        "422": "Unprocessable Content",
        "429": "Too Many Requests",
        "500": "Internal Server Error",
        "503": "Service Unavailable"
    },
    "collection": {
        "auth": {
            "login": {
                "url": "{{env.baseurl}}/auth/login",
                "headers": [
                    {
                        "name": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "schema": {
                        "fields": {
                            "username": {
                                "type": "string",
                                "required": true
                            },
                            "password": {
                                "type": "string",
                                "required": true
                            }
                        }
                    }
                },
                "response": {
                    "success": {
                        "headers": [
                            {
                                "name": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "code": [
                            200
                        ],
                        "schema": {
                            "fields": {
                                "access_token": {
                                    "type": "string"
                                },
                                "token_type": {
                                    "type": "string"
                                },
                                "expires_in": {
                                    "type": "number"
                                },
                                "user": {
                                    "type": "object<User>"
                                }
                            }
                        }
                    },
                    "error": {
                        "headers": [
                            {
                                "name": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "code": [
                            401
                        ],
                        "schema": {
                            "fields": {
                                "message": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                }
            },
            "register": {
                "url": "{{env.baseurl}}/auth/register",
                "headers": [
                    {
                        "name": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "schema": {
                        "fields": {
                            "username": {
                                "type": "string",
                                "required": true,
                                "pattern": "^[a-z][a-z0-9]{2,14}$"
                            },
                            "password": {
                                "type": "string",
                                "required": true,
                                "pattern": "^(?=.*?[A-Z])(?=.*?[a-z])(?=.*?[0-9])(?=.*?[#?!@$%^&*-+]).+$"
                            },
                            "password_confirmation": {
                                "type": "password_confirmation",
                                "required": true
                            }
                        }
                    }
                },
                "response": {
                    "success": {
                        "headers": [
                            {
                                "name": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "code": [
                            200
                        ],
                        "schema": {
                            "fields": {
                                "access_token": {
                                    "type": "string"
                                },
                                "token_type": {
                                    "type": "string"
                                },
                                "expires_in": {
                                    "type": "number"
                                },
                                "user": {
                                    "type": "object<User>"
                                }
                            }
                        }
                    },
                    "error": {
                        "headers": [
                            {
                                "name": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "code": [
                            409
                        ],
                        "schema": {
                            "fields": {
                                "message": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                }
            },
            "logout": {
                "url": "{{env.baseurl}}/auth/logout",
                "headers": [
                    {
                        "name": "Authorization",
                        "value": "Bearer {{env.token}}"
                    },
                    {
                        "name": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "schema": {
                        "fields": {}
                    }
                },
                "response": {
                    "success": {
                        "headers": [
                            {
                                "name": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "code": [
                            200
                        ],
                        "schema": {
                            "fields": {
                                "message": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                }
            }
        },
        "expression": {
            "evaluate": {
                "url": "{{env.baseurl}}/expression/evaluate",
                "headers": [
                    {
                        "name": "Authorization",
