                "body": {
                    "schema": {
                        "fields": {
                            "source": {
                                "type": "string",
                                "required": true
                            },
                            "fileId": {
                                "type": "number",
                                "required": false,
                                "exclusiveWith": "expressionId"
                            },
                            "expressionId": {
                                "type": "number",
                                "required": false,
                                "exclusiveWith": "fileId"
                            }
                        }
                    }
                },
                "response": {
                    "success": {
                        "headers": [
                            {
                                "name": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "code": [
                            200
                        ],
                        "schema": {
                            "fields": {
                                "expression": {
                                    "type": "object<Expression>"
                                }
                            }
                        }
                    },
                    "error": {
                        "headers": [
                            {
                                "name": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "code": [
                            400,
                            404
                        ],
                        "schema": {
                            "fields": {
                                "message": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                }
            }
        },
