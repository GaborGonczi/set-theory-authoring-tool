# Docker Compose
COMPOSE_PROJECT_NAME=myapp
APP_DOMAIN=app.example.com

# Laravel
APP_NAME="My Laravel App"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://app.example.com
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# Adatbázis — a saját adatbázisod adatai
DB_CONNECTION=mysql
DB_HOST=host.docker.internal
DB_PORT=3306
DB_DATABASE=myapp
DB_USERNAME=myapp_user
DB_PASSWORD=replace_with_a_strong_password
DB_ROOT_PASSWORD=replace_with_a_strong_password

# Időzóna
TZ=Europe/Budapest

JWT_SECRET=

REVERB_APP_ID=random_int(100_000, 999_999)
REVERB_APP_KEY=Illuminate\Support\Str::lower(Illuminate\Support\Str::random(20))
REVERB_APP_SECRET=Illuminate\Support\Str::lower(Illuminate\Support\Str::random(20))
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=reverb

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${DOMAIN}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME=https
