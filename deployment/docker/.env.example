# Docker Compose
COMPOSE_PROJECT_NAME=myapp
APP_DOMAIN=app.example.com

# Laravel
APP_NAME="My Laravel App"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://app.example.com
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# Adatbázis — a saját adatbázisod adatai
DB_CONNECTION=mysql
DB_HOST=host.docker.internal
DB_PORT=3306
DB_DATABASE=myapp
DB_USERNAME=myapp_user
DB_PASSWORD=replace_with_a_strong_password
DB_ROOT_PASSWORD=replace_with_a_strong_password

# Időzóna
TZ=Europe/Budapest

JWT_SECRET=
